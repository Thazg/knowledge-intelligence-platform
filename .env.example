# Runtime profile
# local: existing local Qdrant + SentenceTransformers + BM25 + Ollama
# cloud: Qdrant Cloud + FastEmbed + exact sparse BM25 + Groq
RAG_PROFILE=local

# Infrastructure
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434

# Cloud-only infrastructure
# QDRANT_API_KEY=replace-me

# Data
CHUNKS_PATH=data/processed/chunks_fixed.jsonl

# Cloud-only retrieval artifact
# BM25_QUERY_ARTIFACT_PATH=artifacts/retrieval/rank-bm25-query-artifact-v1.json

# Embedding / Vector Store
QDRANT_COLLECTION=enterprise_knowledge_fixed_bge_small

# Generation
GENERATION_MODEL=qwen3:4b-instruct
GENERATION_TIMEOUT_SECONDS=120
MAX_CONCURRENT_GENERATIONS=1

# Cloud-only generation
# GROQ_API_KEY=replace-me

# Retrieval
DENSE_WEIGHT=0.7
BM25_WEIGHT=0.3
RRF_K=60
RETRIEVAL_TOP_K=10

# Context
MAX_CONTEXT_TOKENS=4000
MAX_CONTEXT_SOURCES=6