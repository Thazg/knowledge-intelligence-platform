FROM python:3.13-slim@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6

WORKDIR /app

COPY requirements-cloud.txt .
COPY constraints/runtime-py313-linux-amd64.txt constraints/runtime-py313-linux-amd64.txt

RUN pip install \
    --no-cache-dir \
    -r requirements-cloud.txt \
    -c constraints/runtime-py313-linux-amd64.txt

COPY . .

EXPOSE 8000

CMD ["sh", "-c", "exec python -m uvicorn backend.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]